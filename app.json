{
  "expo": {
    "name": "Sapp2",
    "slug": "sapp2",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "scheme": "sapp2",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0B0E14"
    },
    "android": {
      "backgroundColor": "#0B0E14",
      "package": "com.sokki.sapp2",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0B0E14"
      },
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.VIBRATE",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.USE_FULL_SCREEN_INTENT",
        "android.permission.SCHEDULE_EXACT_ALARM",
        "android.permission.health.READ_STEPS",
        "android.permission.health.READ_SLEEP",
        "android.permission.health.READ_WEIGHT",
        "android.permission.health.READ_RESTING_HEART_RATE",
        "android.permission.health.READ_HYDRATION",
        "android.permission.ACCESS_COARSE_LOCATION"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-notifications",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Pogoda dla Twojej okolicy."
        }
      ],
      "./plugins/withFullScreenAlert.js",
      "./plugins/withBankNotificationListener.js",
      "./plugins/withReceiptShareIntent.js",
      "./plugins/withTasksWidget.js",
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26,
            "compileSdkVersion": 36,
            "targetSdkVersion": 36
          }
        }
      ],
      "@react-native-community/datetimepicker",
      "react-native-health-connect",
      "./plugins/withHealthConnectQueries.js"
    ]
  }
}
